# Copy to .env for deployment. Never commit the real .env file.
BASE_DOMAIN=yourdomain.com
LANDING_URL=https://fraud.yourdomain.com
APP_PUBLIC_URL=https://app.yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com
MLFLOW_PUBLIC_URL=https://mlflow.yourdomain.com
LOCUST_PUBLIC_URL=https://locust.yourdomain.com
GITHUB_URL=https://github.com/your-account/AIDev_CC_Fraud_MLOPS_Locust

# Docker-internal service URLs. Do not replace these with public HTTPS URLs.
INTERNAL_API_URL=http://backend:8000
INTERNAL_MLFLOW_TRACKING_URI=http://mlflow:5000
INTERNAL_H2O_URL=http://h2o:54321

ALLOWED_ORIGINS=https://fraud.yourdomain.com,https://app.yourdomain.com
MLFLOW_SERVER_ALLOWED_HOSTS=mlflow,localhost,127.0.0.1,backend,trainer,mlflow.yourdomain.com

MODEL_NAME=fraud-detection-automl
MODEL_ALIAS=champion
MODEL_ARTIFACT_DIR=/app/model_artifacts
LOCUST_SAMPLE_ROWS=25
CERTBOT_EMAIL=replace-with-your-email@example.com

# Keep host-published application ports on EC2 loopback; H2O has no host port.
MLFLOW_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1
